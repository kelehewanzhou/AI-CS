# Generate a usable local .env: python scripts/manage.py init-env
# Use different URL-safe random strings for all three database passwords.
DB_ADMIN_PASSWORD=
DB_MIGRATION_PASSWORD=
DB_PASSWORD=
DATABASE_URL=postgresql+psycopg://kglearn_app:REPLACE_WITH_DB_PASSWORD@postgres:5432/kglearn
MIGRATION_DATABASE_URL=postgresql+psycopg://kglearn_migrator:REPLACE_WITH_DB_MIGRATION_PASSWORD@postgres:5432/kglearn
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=kglearn_session

# Local validation only. Production requires exact external HTTPS Origins.
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
HTTP_PORT=8080
VERSION=v1.0.0
SEED_DIR=./fixtures
SEED_OPERATOR=deploy@system
NGINX_SERVER_NAME=localhost
NGINX_TLS=0
# Behind a school gateway, allow only its actual IP/CIDR.
NGINX_TRUSTED_PROXIES=
# Set 1 to include docker-compose.tls.yml and mount nginx/ssl/*.pem.
COMPOSE_TLS=0
